# Clinika API as seen from the website container.
# Same server, docker: the website joins Clinika's network and reaches the "backend" service directly.
NUXT_BACKEND_URL=http://backend:4000/api/v1

# Public address of the website (sitemap.xml, social previews, hreflang links)
NUXT_PUBLIC_SITE_URL=https://klinika.uz

# Docker network created by Clinika's docker compose: <COMPOSE_PROJECT_NAME>_default (Clinika default: shifoxona)
CLINIKA_NETWORK=shifoxona_default

# Host port the website listens on (nginx proxies the domain to it)
WEBSITE_PORT=3001
WEBSITE_BIND=127.0.0.1
